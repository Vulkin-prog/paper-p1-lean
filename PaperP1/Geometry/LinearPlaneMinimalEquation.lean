module

public import PaperP1.Geometry.LinearPlaneImage
public import PaperP1.Algebra.HomogeneousMonicGenerator
public import PaperP1.Algebra.GradedQuotientIdealCongruence
public import PaperP1.Algebra.PlaneCurveHilbert
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.Algebra.GCDMonoid.IntegrallyClosed
public import Mathlib.RingTheory.Ideal.Maximal

/-! # The actual plane-image ideal is generated by its monic homogeneous minimal equation -/

set_option autoImplicit false

@[expose] public noncomputable section

namespace PaperP1.LinearPlaneMinimalEquation

open MvPolynomial LinearPlaneImage
attribute [local instance] MvPolynomial.gradedAlgebra

variable {F A : Type*} [Field F] [CommRing A]

local instance polynomialRing (σ : Type*) : CommRing (MvPolynomial σ F) := inferInstance
local instance polynomialSemiring (σ : Type*) : Semiring (MvPolynomial σ F) :=
  (polynomialRing σ).toSemiring

variable [Algebra (MvPolynomial (Fin 2) F) A]

def equation (y : A) : MvPolynomial (Fin 3) F :=
  (finSuccEquiv F 2).symm (minpoly (MvPolynomial (Fin 2) F) y)

theorem equation_monic (y : A) (hy : IsIntegral (MvPolynomial (Fin 2) F) y) :
    (finSuccEquiv F 2 (equation (F := F) y)).Monic := by
  rw [equation, AlgEquiv.apply_symm_apply]
  exact minpoly.monic hy

theorem equation_nonzero (y : A) (hy : IsIntegral (MvPolynomial (Fin 2) F) y) :
    equation (F := F) y ≠ 0 := by
  intro hz
  apply (minpoly.monic hy).ne_zero
  have he := congrArg (finSuccEquiv F 2) hz
  simpa only [equation, AlgEquiv.apply_symm_apply, map_zero] using he

variable [Algebra F A] [IsScalarTower F (MvPolynomial (Fin 2) F) A]

theorem evaluation_factor (g : Fin 2 → A) (y : A)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom) :
    aeval (R := F) (coordinates g y) =
      ((Polynomial.aeval y).restrictScalars F).comp (finSuccEquiv F 2).toAlgHom := by
  apply MvPolynomial.algHom_ext
  intro i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · change aeval (coordinates g y) (X 0) = Polynomial.aeval y (finSuccEquiv F 2 (X 0))
    rw [aeval_X, finSuccEquiv_X_zero, Polynomial.aeval_X]
    rfl
  · change aeval (coordinates g y) (X j.succ) = Polynomial.aeval y (finSuccEquiv F 2 (X j.succ))
    rw [aeval_X, finSuccEquiv_X_succ, Polynomial.aeval_C, DFunLike.congr_fun hsource (X j)]
    change coordinates g y j.succ = aeval g (X j)
    rw [aeval_X]
    rfl

variable [IsDomain A] [Module.IsTorsionFree (MvPolynomial (Fin 2) F) A]

theorem principal (g : Fin 2 → A) (y : A)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom)
    (hy : IsIntegral (MvPolynomial (Fin 2) F) y) :
    ideal (F := F) g y = Ideal.span {equation (F := F) y} := by
  ext P
  rw [Ideal.mem_span_singleton]
  change aeval (coordinates g y) P = 0 ↔ equation (F := F) y ∣ P
  rw [evaluation_factor g y hsource]
  change Polynomial.aeval y (finSuccEquiv F 2 P) = 0 ↔ equation (F := F) y ∣ P
  rw [minpoly.isIntegrallyClosed_dvd_iff hy]
  have he : finSuccEquiv F 2 (equation (F := F) y) = minpoly (MvPolynomial (Fin 2) F) y :=
    (finSuccEquiv F 2).apply_symm_apply _
  rw [← he]
  exact map_dvd_iff (finSuccEquiv F 2)

theorem equation_irreducible (g : Fin 2 → A) (y : A)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom)
    (hy : IsIntegral (MvPolynomial (Fin 2) F) y) : Irreducible (equation (F := F) y) := by
  apply Prime.irreducible
  apply (Ideal.span_singleton_prime (equation_nonzero y hy)).mp
  rw [← principal g y hsource hy]
  exact ideal_prime g y

theorem equation_homogeneous (H : ℕ → Submodule F A) [GradedAlgebra H]
    (g : Fin 2 → A) (hg : ∀ i, g i ∈ H 1) (y : A) (hy : y ∈ H 1)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom)
    (hint : IsIntegral (MvPolynomial (Fin 2) F) y) :
    (equation (F := F) y).IsHomogeneous (minpoly (MvPolynomial (Fin 2) F) y).natDegree := by
  have hI : (Ideal.span {equation (F := F) y}).IsHomogeneous (homogeneousSubmodule (Fin 3) F) := by
    rw [← principal g y hsource hint]
    exact ideal_homogeneous H g hg y hy
  simpa only [equation, AlgEquiv.apply_symm_apply] using
    HomogeneousMonicGenerator.homogeneous (equation (F := F) y) hI (equation_monic y hint)

theorem equation_totalDegree (H : ℕ → Submodule F A) [GradedAlgebra H]
    (g : Fin 2 → A) (hg : ∀ i, g i ∈ H 1) (y : A) (hy : y ∈ H 1)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom)
    (hint : IsIntegral (MvPolynomial (Fin 2) F) y) :
    (equation (F := F) y).totalDegree = (minpoly (MvPolynomial (Fin 2) F) y).natDegree :=
  (equation_homogeneous H g hg y hy hsource hint).totalDegree (equation_nonzero y hint)

theorem degree_of_image_hilbert (H : ℕ → Submodule F A) [GradedAlgebra H]
    (g : Fin 2 → A) (hg : ∀ i, g i ∈ H 1) (y : A) (hy : y ∈ H 1)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom)
    (hint : IsIntegral (MvPolynomial (Fin 2) F) y) (d : ℕ) (b : ℚ)
    (hp : GradedHilbertPolynomial.IsHilbertPolynomial (piece (F := F) g y)
      (Polynomial.C (d : ℚ) * Polynomial.X + Polynomial.C b)) :
    (equation (F := F) y).totalDegree = d := by
  have hpq : GradedHilbertPolynomial.IsHilbertPolynomial (PlaneCurveHilbert.piece F (equation (F := F) y))
      (Polynomial.C (d : ℚ) * Polynomial.X + Polynomial.C b) :=
    GradedQuotientIdealCongruence.hilbertPolynomial (homogeneousSubmodule (Fin 3) F)
      (principal g y hsource hint) hp
  have hu := GradedHilbertPolynomial.unique
    (PlaneCurveHilbert.isHilbertPolynomial F (equation (F := F) y)
      (equation_homogeneous H g hg y hy hsource hint) (equation_nonzero y hint)) hpq
  have hc := congrArg (fun p : Polynomial ℚ ↦ p.coeff 1) hu
  have he : (minpoly (MvPolynomial (Fin 2) F) y).natDegree = d := by
    exact_mod_cast (show ((minpoly (MvPolynomial (Fin 2) F) y).natDegree : ℚ) = (d : ℚ) by
      simpa [PlaneCurveHilbert.polynomial] using hc)
  exact (equation_totalDegree H g hg y hy hsource hint).trans he

omit [Module.IsTorsionFree (MvPolynomial (Fin 2) F) A] in
theorem equation_of_finite (H : ℕ → Submodule F A) [GradedAlgebra H]
    (g : Fin 2 → A) (hg : ∀ i, g i ∈ H 1) (y : A) (hy : y ∈ H 1)
    (hsource : algebraMap (MvPolynomial (Fin 2) F) A = (aeval (R := F) g).toRingHom)
    (hfinite : (aeval (R := F) g).Finite) (hinj : Function.Injective (aeval (R := F) g))
    (d : ℕ) (b : ℚ) (hp : GradedHilbertPolynomial.IsHilbertPolynomial (piece (F := F) g y)
      (Polynomial.C (d : ℚ) * Polynomial.X + Polynomial.C b)) :
    ∃ q : MvPolynomial (Fin 3) F, ideal (F := F) g y = Ideal.span {q} ∧ Irreducible q ∧
      q.IsHomogeneous d ∧ q.totalDegree = d ∧ (finSuccEquiv F 2 q).Monic := by
  have hmapinj : Function.Injective (algebraMap (MvPolynomial (Fin 2) F) A) := by rw [hsource]; exact hinj
  let : FaithfulSMul (MvPolynomial (Fin 2) F) A :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hmapinj
  let : Module.IsTorsionFree (MvPolynomial (Fin 2) F) A := inferInstance
  have hfin : Module.Finite (MvPolynomial (Fin 2) F) A := by
    apply RingHom.finite_algebraMap.mp
    rw [hsource]
    exact hfinite
  let : Module.Finite (MvPolynomial (Fin 2) F) A := hfin
  have hint : IsIntegral (MvPolynomial (Fin 2) F) y := IsIntegral.of_finite _ y
  have hdegree := degree_of_image_hilbert H g hg y hy hsource hint d b hp
  have hnat : (minpoly (MvPolynomial (Fin 2) F) y).natDegree = d :=
    (equation_totalDegree H g hg y hy hsource hint).symm.trans hdegree
  refine ⟨equation (F := F) y, principal g y hsource hint, equation_irreducible g y hsource hint, ?_, hdegree,
    equation_monic y hint⟩
  rw [← hnat]
  exact equation_homogeneous H g hg y hy hsource hint

end PaperP1.LinearPlaneMinimalEquation
