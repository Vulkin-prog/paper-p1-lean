module

public import PaperP1.Algebra.AffinePowerProjectionImage
public import PaperP1.Arithmetic.ConductorCriticalPointTransfer

/-! # Uniform point bounds for the actual affine projected image with its conductor proved internally

The image is the literal algebra generated by y,Y^D,X^D. Its generation,
equation and derivative conductor are internal proofs. The cutoff precedes
the prime, coefficients, bounded branch supports, primitive element and
polynomial; monic irreducibility and the actual full-degree relation remain
explicit until verified for the original reduced integer model.
-/

set_option autoImplicit false
@[expose] public noncomputable section
namespace PaperP1.ActualAffineProjectionPointCount
open Polynomial PaperP1.LocalizedAffineQuadraticSource PaperP1.AffinePowerParameterFractionField
open PaperP1.AffinePowerProjectionImage
attribute [local instance] PaperP1.BivariateQuadraticTowerPoints.scalarAlgebra
attribute [local instance] PaperP1.BivariateQuadraticTowerPoints.scalarTower
open PaperP1.SplitRadicalCoordinateAlgebra

theorem cardinality_le (p : ℕ) [Fact p.Prime] (k D : ℕ) (hD : 0 < D)
    (c : Fin k → ZMod p) (I J : Fin k → Finset ℤ)
    (y : CoordinateAlgebra (List.finRange k) c I J)
    (P : (Parameters (ZMod p))[X]) (hmonic : P.Monic) (hP : Irreducible P)
    (hy : letI := sourceAlgebra (ZMod p) D (radicands (List.finRange k) c I J); Polynomial.aeval y P = 0)
    (hfull : 2 ^ k * D ^ 2 ≤ P.natDegree) (d : ℕ) (hdegree : P.natDegree ≤ d) (hlt : d < p)
    (hcoef : ∀ i, (P.coeff i).totalDegree ≤ d) :
    Nat.card (image (ZMod p) D (radicands (List.finRange k) c I J) y →ₐ[ZMod p] ZMod p) ≤
      (PaperP1.SplitRadicalFiniteFieldPointCount.points c I J).card + 2*d^3*p := by
  let s := radicands (List.finRange k) c I J
  have hlen : s.length = k := by simp only [s, radicands, List.length_map, List.length_finRange]
  have hfull' : 2 ^ s.length * D ^ 2 ≤ P.natDegree := by rwa [hlen]
  have hpos : 0 < P.natDegree := (by positivity : 0 < 2 ^ k * D ^ 2).trans_le hfull
  exact PaperP1.ConductorCriticalPointTransfer.split_cardinality_le p k c I J
    (image (ZMod p) D s y) (polynomial (ZMod p) D s y P.derivative)
    (conductor (ZMod p) D s hD p P hmonic hP y hy hfull' (hdegree.trans_lt hlt))
    (v (ZMod p) D s y) (z (ZMod p) D s y) (image_generated (ZMod p) D s y)
    P hmonic hP hpos d hdegree hlt hcoef (equation (ZMod p) D s y P hy) rfl

theorem uniform_upper_bound (k D M d : ℕ) (hD : 0 < D) (η : ℝ) (hη : 0 < η) :
    ∃ K : ℕ, ∀ (p : ℕ) (hp : p.Prime), K ≤ p →
      letI : Fact p.Prime := ⟨hp⟩
      ∀ (c : Fin k → ZMod p) (I J : Fin k → Finset ℤ),
      (PaperP1.SplitBranchPrimeCertificate.support I J).card ≤ M →
      (Pairwise fun i j ↦ Disjoint (I i) (I j)) →
      (Pairwise fun i j ↦ Disjoint (J i) (J j)) →
      (∀ i, (I i).Nonempty ∨ (J i).Nonempty) →
      ¬ (p : ℤ) ∣ PaperP1.BranchShiftReductionCertificate.certificate
        (PaperP1.SplitBranchPrimeCertificate.support I J) →
      ∀ (y : CoordinateAlgebra (List.finRange k) c I J) (P : (Parameters (ZMod p))[X]),
      P.Monic → Irreducible P →
      (letI := sourceAlgebra (ZMod p) D (radicands (List.finRange k) c I J); Polynomial.aeval y P = 0) →
      2 ^ k * D ^ 2 ≤ P.natDegree → P.natDegree ≤ d →
      (∀ i, (P.coeff i).totalDegree ≤ d) →
      ((Nat.card (image (ZMod p) D (radicands (List.finRange k) c I J) y →ₐ[ZMod p] ZMod p) : ℕ) : ℝ) ≤
        (1+η)*(p : ℝ)^2 := by
  obtain ⟨K, hK⟩ := PaperP1.ConductorCriticalPointTransfer.uniform_upper_bound k M d η hη
  refine ⟨max K (d+1), ?_⟩
  intro p hp hlarge
  let : Fact p.Prime := ⟨hp⟩
  intro c I J hsupport hI hJ hne hnot y P hmonic hP hy hfull hdegree hcoef
  let s := radicands (List.finRange k) c I J
  have hlen : s.length = k := by simp only [s, radicands, List.length_map, List.length_finRange]
  have hfull' : 2 ^ s.length * D ^ 2 ≤ P.natDegree := by rwa [hlen]
  have hpos : 0 < P.natDegree := (by positivity : 0 < 2 ^ k * D ^ 2).trans_le hfull
  have hdp : d < p := (Nat.lt_succ_self d).trans_le ((Nat.le_max_right K (d+1)).trans hlarge)
  exact hK p hp ((Nat.le_max_left K (d+1)).trans hlarge) c I J hsupport hI hJ hne hnot
    (image (ZMod p) D s y) (polynomial (ZMod p) D s y P.derivative)
    (conductor (ZMod p) D s hD p P hmonic hP y hy hfull' (hdegree.trans_lt hdp))
    (v (ZMod p) D s y) (z (ZMod p) D s y) (image_generated (ZMod p) D s y)
    P hmonic hP hpos hdegree hcoef (equation (ZMod p) D s y P hy) rfl

end PaperP1.ActualAffineProjectionPointCount
