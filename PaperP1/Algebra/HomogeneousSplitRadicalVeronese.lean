module

public import PaperP1.Algebra.HomogeneousSplitRadicalGrading
public import PaperP1.Algebra.WeightedVeroneseGeneration
public import PaperP1.Algebra.GradedVeroneseAlgebra
public import PaperP1.Algebra.SplitWeightedDegreeGenerators
public import PaperP1.Algebra.HomogeneousSplitRadicalPresentation
public import Mathlib.RingTheory.FiniteType

/-! # The actual source Veronese algebra is generated by its degree-D piece -/

set_option autoImplicit false

@[expose] public noncomputable section

namespace PaperP1.HomogeneousSplitRadicalVeronese

open Finset PaperP1.HomogeneousSplitRadicalRelations PaperP1.HomogeneousSplitRadicalGrading

local instance pieceGradedMonoid {F ι : Type*} [Field F]
    (c : ι → F) (D : ℕ) (I J : ι → Finset ℤ) : SetLike.GradedMonoid (piece c D I J) :=
  WeightedPolynomialQuotientGrading.gradedMonoid (weight ι D) (relationIdeal c D I J)

def veronese {F ι : Type*} [Field F] (c : ι → F) (D : ℕ) (I J : ι → Finset ℤ) :
    Subalgebra F (CoordinateRing c D I J) := GradedVeroneseAlgebra.veronese (piece c D I J) D

theorem degreeImage_eq_piece {F ι : Type*} [Field F]
    (c : ι → F) (D : ℕ) (I J : ι → Finset ℤ) (n : ℕ) :
    WeightedVeroneseGeneration.degreeImage (weight ι D) (Ideal.Quotient.mkₐ F (relationIdeal c D I J)) n =
      (piece c D I J n : Set (CoordinateRing c D I J)) := by
  ext x
  rfl

theorem veronese_eq_image {F ι : Type*} [Field F]
    (c : ι → F) (D : ℕ) (I J : ι → Finset ℤ) :
    veronese c D I J = WeightedVeroneseGeneration.veroneseAlgebra (weight ι D)
      (Ideal.Quotient.mkₐ F (relationIdeal c D I J)) D := by
  rw [veronese, GradedVeroneseAlgebra.veronese_eq_adjoin]
  simp only [WeightedVeroneseGeneration.veroneseAlgebra, degreeImage_eq_piece]
  rfl

theorem weight_cases (ι : Type*) (D : ℕ) (i : Fin 3 ⊕ ι) :
    weight ι D i = 1 ∨ weight ι D i = D := by
  cases i with
  | inl j => exact Or.inl rfl
  | inr i => exact Or.inr rfl

theorem generated_in_degreeD {F ι : Type*} [Field F]
    (c : ι → F) (D : ℕ) (hD : 0 < D) (I J : ι → Finset ℤ) :
    veronese c D I J = Algebra.adjoin F (piece c D I J D : Set (CoordinateRing c D I J)) := by
  rw [veronese_eq_image, WeightedVeroneseGeneration.veronese_generated
    (weight ι D) D hD (weight_cases ι D), degreeImage_eq_piece]

theorem generated_by_source_generators {F ι : Type*} [Field F]
    (c : ι → F) (D : ℕ) (hD : 0 < D) (I J : ι → Finset ℤ) :
    veronese c D I J = Algebra.adjoin F
      ((Ideal.Quotient.mkₐ F (relationIdeal c D I J)) '' SplitWeightedDegreeGenerators.generators F ι D) := by
  rw [generated_in_degreeD c D hD I J]
  apply le_antisymm
  · apply Algebra.adjoin_le
    intro x hx
    obtain ⟨p, hp, hpx⟩ := Submodule.mem_map.mp hx
    exact hpx ▸ SplitWeightedDegreeGenerators.degreeD_image_mem D hD
      (Ideal.Quotient.mkₐ F (relationIdeal c D I J)) p hp
  · apply Algebra.adjoin_le
    rintro x ⟨p, hp, rfl⟩
    apply Algebra.subset_adjoin
    exact Submodule.mem_map.mpr ⟨p, SplitWeightedDegreeGenerators.generator_homogeneous D hp, rfl⟩

theorem finiteType {F ι : Type*} [Field F] [Finite ι]
    (c : ι → F) (D : ℕ) (hD : 0 < D) (I J : ι → Finset ℤ) :
    Algebra.FiniteType F (veronese c D I J) := by
  rw [generated_by_source_generators c D hD I J]
  exact Algebra.FiniteType.adjoin_of_finite ((SplitWeightedDegreeGenerators.generators_finite F ι D).image _)

theorem source_isDomain {F : Type*} [Field F] [CharZero F]
    (s : List (HomogeneousSplitRadicalData.PolynomialRing F)) (c : Fin s.length → F) (D : ℕ)
    (I J : Fin s.length → Finset ℤ)
    (hs : ∀ i, s.get i = HomogeneousSplitRadicalData.radicand
      (c i) (2 * D - ((I i).card + (J i).card)) (I i) (J i))
    (hc : ∀ i, c i ≠ 0) (hne : ∀ i, (I i).Nonempty ∨ (J i).Nonempty)
    (hI : Pairwise fun i j ↦ Disjoint (I i) (I j)) (hJ : Pairwise fun i j ↦ Disjoint (J i) (J j)) :
    IsDomain (veronese c D I J) := by
  have := HomogeneousSplitRadicalPresentation.source_presentation_isDomain s c D I J hs hc hne hI hJ
  exact inferInstance

end PaperP1.HomogeneousSplitRadicalVeronese
