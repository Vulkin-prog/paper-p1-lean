module

public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-! # The actual irrelevant ideal is generated by any homogeneous degree-one algebra generators -/

set_option autoImplicit false

@[expose] public noncomputable section

namespace PaperP1.IrrelevantGenerated

open DirectSum

variable {F A : Type*} [CommRing F] [CommRing A] [Algebra F A]
variable (G : ℕ → Submodule F A) [GradedAlgebra G]

theorem irrelevant_eq_span (T : Set A) (hT : ∀ x ∈ T, x ∈ G 1) (hgen : Algebra.adjoin F T = ⊤) :
    (HomogeneousIdeal.irrelevant G).toIdeal = Ideal.span T := by
  let K := Ideal.span T
  have hK : K ≤ (HomogeneousIdeal.irrelevant G).toIdeal := by
    apply Ideal.span_le.mpr
    intro x hx
    exact HomogeneousIdeal.mem_irrelevant_of_mem G (by decide : 0 < 1) (hT x hx)
  let φ := Ideal.Quotient.mkₐ F K
  have hrange : φ.range ≤ ⊥ := by
    calc
      φ.range = (⊤ : Subalgebra F A).map φ := (Algebra.map_top φ).symm
      _ = (Algebra.adjoin F T).map φ := by rw [hgen]
      _ = Algebra.adjoin F (φ '' T) := (Algebra.adjoin_image F φ T).symm
      _ ≤ ⊥ := by
        apply Algebra.adjoin_le
        rintro _ ⟨t, ht, rfl⟩
        have hz : φ t = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ht)
        rw [hz]
        exact (⊥ : Subalgebra F (A ⧸ K)).zero_mem
  apply le_antisymm _ hK
  intro x hx
  obtain ⟨c, hc⟩ := Algebra.mem_bot.mp (hrange (show φ x ∈ φ.range from ⟨x, rfl⟩))
  have hzK : x - algebraMap F A c ∈ K := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change φ (x - algebraMap F A c) = 0
    rw [map_sub, φ.commutes, hc, sub_self]
  have hx0 : GradedRing.projZeroRingHom G x = 0 := hx
  have hz0 : GradedRing.projZeroRingHom G (x - algebraMap F A c) = 0 := hK hzK
  have hc0 : GradedRing.projZeroRingHom G (algebraMap F A c) = algebraMap F A c := by
    change (decompose G (algebraMap F A c) 0 : A) = algebraMap F A c
    apply decompose_of_mem_same G
    rw [Algebra.algebraMap_eq_smul_one]
    exact (G 0).smul_mem c (SetLike.one_mem_graded G)
  rw [map_sub, hx0, hc0, zero_sub, neg_eq_zero] at hz0
  simpa only [hz0, sub_zero] using hzK

theorem irrelevant_le_radical (T : Set A) (hT : ∀ x ∈ T, x ∈ G 1) (hgen : Algebra.adjoin F T = ⊤)
    (J : Ideal A) (hJ : ∀ x ∈ T, x ∈ J.radical) :
    (HomogeneousIdeal.irrelevant G).toIdeal ≤ J.radical := by
  rw [irrelevant_eq_span G T hT hgen]
  exact Ideal.span_le.mpr hJ

end PaperP1.IrrelevantGenerated
