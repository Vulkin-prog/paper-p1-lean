module

public import PaperP1.Algebra.FullDegreeSourceDerivativeConductor
public import PaperP1.Algebra.BivariateQuadraticTowerPoints
public import Mathlib.RingTheory.Adjoin.Basic

/-! # The literal three-coordinate affine projected image and its proved derivative conductor

The image is generated over F by y,Y^D,X^D. It is exactly the parameter
algebra generated by y, viewed over F. Every polynomial evaluation and the
full-degree derivative conductor refer to these actual coordinates.
-/

set_option autoImplicit false
@[expose] public noncomputable section
namespace PaperP1.AffinePowerProjectionImage
open Polynomial PaperP1.LocalizedAffineQuadraticSource PaperP1.AffinePowerParameterFractionField
attribute [local instance] PaperP1.BivariateQuadraticTowerPoints.scalarAlgebra
attribute [local instance] PaperP1.BivariateQuadraticTowerPoints.scalarTower
variable (F : Type*) [Field F] (D : ℕ) (s : List (Base F))

def parameters : Fin 2 → Source F s :=
  ![algebraMap (Base F) (Source F s) (X ^ D), algebraMap (Base F) (Source F s) ((C X) ^ D)]

def parameterMap : Parameters F →ₐ[F] Source F s :=
  (IsScalarTower.toAlgHom F (Base F) (Source F s)).comp (powerMap F D)

theorem parameterMap_variables (i : Fin 2) : parameterMap F D s (MvPolynomial.X i) = parameters F D s i := by
  fin_cases i
  · change algebraMap (Base F) (Source F s) (powerMap F D (MvPolynomial.X 0)) = _
    rw [powerMap_zero]
    rfl
  · change algebraMap (Base F) (Source F s) (powerMap F D (MvPolynomial.X 1)) = _
    rw [powerMap_one]
    rfl

theorem parameterMap_evaluation : parameterMap F D s = MvPolynomial.aeval (parameters F D s) := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [MvPolynomial.aeval_X, parameterMap_variables]

theorem sourceScalarTower : letI := sourceAlgebra F D s
    IsScalarTower F (Parameters F) (Source F s) := by
  let := sourceAlgebra F D s
  exact IsScalarTower.of_algebraMap_eq (fun r ↦ ((parameterMap F D s).commutes r).symm)

def coordinates (y : Source F s) : Fin 3 → Source F s := Fin.cons y (parameters F D s)
def image (y : Source F s) : Subalgebra F (Source F s) :=
  Algebra.adjoin F (Set.range (coordinates F D s y))

theorem image_eq_parameter_adjoin (y : Source F s) :
    letI := sourceAlgebra F D s
    letI := sourceScalarTower F D s
    image F D s y = (Algebra.adjoin (Parameters F) {y}).restrictScalars F := by
  let := sourceAlgebra F D s
  let := sourceScalarTower F D s
  rw [Algebra.Subalgebra.restrictScalars_adjoin]
  have he : IsScalarTower.toAlgHom F (Parameters F) (Source F s) = parameterMap F D s := by
    ext P
    rfl
  rw [he, parameterMap_evaluation, MvPolynomial.aeval_range, ← Algebra.adjoin_union]
  unfold image coordinates
  rw [Fin.range_cons, Set.union_comm]
  rw [Set.singleton_union]

section General
variable {F A σ : Type*} [Field F] [CommRing A] [Algebra F A]

theorem generated_coordinates (c : σ → A) :
    let S := Algebra.adjoin F (Set.range c)
    let x : σ → S := fun i ↦ ⟨c i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
    Algebra.adjoin F (Set.range x) = ⊤ := by
  let S := Algebra.adjoin F (Set.range c)
  let x : σ → S := fun i ↦ ⟨c i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  apply Subalgebra.map_injective (f := S.val) Subtype.val_injective
  have hh := AlgHom.map_adjoin S.val (Set.range x)
  rw [← Set.range_comp] at hh
  change (Algebra.adjoin F (Set.range x)).map S.val = (⊤ : Subalgebra F S).map S.val
  rw [Algebra.map_top, Subalgebra.range_val]
  exact hh
end General

def z (y : Source F s) : image F D s y :=
  ⟨y, Algebra.subset_adjoin ⟨0, rfl⟩⟩

def v (y : Source F s) (i : Fin 2) : image F D s y :=
  ⟨parameters F D s i, Algebra.subset_adjoin ⟨i.succ, rfl⟩⟩

theorem image_generated (y : Source F s) :
    Algebra.adjoin F (Set.range (Fin.cons (z F D s y) (v F D s y))) = ⊤ := by
  have hh := generated_coordinates (F := F) (coordinates F D s y)
  dsimp only at hh
  have he : (fun i : Fin 3 ↦ (⟨coordinates F D s y i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : image F D s y)) =
      Fin.cons (z F D s y) (v F D s y) := by
    funext i
    refine Fin.cases ?_ (fun _ ↦ ?_) i <;> rfl
  exact (congrArg (fun x : Fin 3 → image F D s y ↦ Algebra.adjoin F (Set.range x)) he).symm.trans hh

def polynomial (y : Source F s) (P : (Parameters F)[X]) : image F D s y :=
  P.eval₂ (MvPolynomial.aeval (v F D s y)).toRingHom (z F D s y)

theorem polynomial_value (y : Source F s) (P : (Parameters F)[X]) :
    letI := sourceAlgebra F D s
    (polynomial F D s y P : Source F s) = Polynomial.aeval y P := by
  let := sourceAlgebra F D s
  change (image F D s y).val.toRingHom
    (P.eval₂ (MvPolynomial.aeval (v F D s y)).toRingHom (z F D s y)) = _
  rw [Polynomial.hom_eval₂]
  have he : (image F D s y).val.comp (MvPolynomial.aeval (v F D s y)) = parameterMap F D s := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, MvPolynomial.aeval_X, parameterMap_variables]
    rfl
  have hc : (image F D s y).val.toRingHom.comp (MvPolynomial.aeval (v F D s y)).toRingHom =
      algebraMap (Parameters F) (Source F s) := congrArg AlgHom.toRingHom he
  rw [hc]
  rfl

theorem equation (y : Source F s) (P : (Parameters F)[X])
    (hy : letI := sourceAlgebra F D s; Polynomial.aeval y P = 0) : polynomial F D s y P = 0 := by
  apply Subtype.ext
  exact (polynomial_value F D s y P).trans hy

theorem conductor (hD : 0 < D) (p : ℕ) [CharP F p]
    (P : (Parameters F)[X]) (hmonic : P.Monic) (hP : Irreducible P)
    (y : Source F s) (hy : letI := sourceAlgebra F D s; Polynomial.aeval y P = 0)
    (hd : 2 ^ s.length * D ^ 2 ≤ P.natDegree) (hlt : P.natDegree < p) :
    ∀ a : Source F s, (polynomial F D s y P.derivative : Source F s) * a ∈ image F D s y := by
  let := sourceAlgebra F D s
  let := sourceScalarTower F D s
  intro a
  rw [polynomial_value, image_eq_parameter_adjoin]
  exact PaperP1.FullDegreeSourceDerivativeConductor.conductor_in_characteristic
    F D hD s p P hmonic hP y hy hd hlt a

end PaperP1.AffinePowerProjectionImage
