module

public import PaperP1.Combinatorics.PairGeneratedTripleWeights
public import PaperP1.Combinatorics.OrderedSubsetWeights
public import PaperP1.Model.SequentialRetainedWindows
public import PaperP1.Model.SourceConditionalDeviations

/-! # Original triples generated by any actual dependent pair family

Branching proves unique source reconstruction away from the literal bad
starts. The finite overcount is bounded by the actual exceptional Palm
mass, with all six ordered representations of each triple retained.
-/

set_option autoImplicit false

@[expose] public noncomputable section

namespace PaperP1.GoodPairGeneratedTriples

open Finset PaperP1.Arithmetic PaperP1.Model PaperP1.Model.InfiniteStarts
  PaperP1.PairGeneratedTripleWeights PaperP1.SourceConditionalDeviations
  PaperP1.BranchingExceptional PaperP1.OldValuePrimeBudget

local instance (P : Prop) : Decidable P := Classical.propDecidable P

def bad (N L : ℕ) (e : Finset ℕ) : Finset ℕ := badStarts N L (rawValues e L)

def ordered (N _L : ℕ) (E : Finset (Finset ℕ)) :=
  OrderedSubsetWeights.population (dyadicBlock N) 3 (families (dyadicBlock N) E)

def orderedMass (N L : ℕ) (E : Finset (Finset ℕ)) : ℝ :=
  ∑ t ∈ ordered N L E, infiniteJointMoment L (PaperP1.Probability.tupleValues t)

theorem retained_source_unique {N L : ℕ} (hN : 2 ≤ N) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, e ⊆ dyadicBlock N ∧ e.card = 2 ∧ 0 < runRelativeNullity L e) :
    ∀ p ∈ points (dyadicBlock N) E, p.2 ∉ bad N L p.1 →
      ∀ f ∈ E, f ⊆ SingletonExtensionWeights.join p → f = p.1 := by
  intro p hp hbad f hf hfp
  obtain ⟨he, hz, hfresh⟩ := point_data hp
  have hnext : p.2 ∈ SequentialRetainedWindows.next N L p.1 :=
    (SequentialRetainedWindows.mem_next N L p.2 p.1).mpr ⟨hz, hfresh, hbad⟩
  have hpath : [p.2] ∈ SequentialRetainedWindows.paths N L p.1 1 := by
    change [p.2] ∈ (SequentialBranchingPaths.paths (SequentialRetainedWindows.next N L) p.1 0).biUnion
      (fun xs ↦ (SequentialRetainedWindows.next N L (SequentialBranchingPaths.old p.1 xs)).image fun z ↦ z :: xs)
    refine mem_biUnion.mpr ⟨[], mem_singleton_self _, mem_image.mpr ⟨p.2, ?_, rfl⟩⟩
    simpa only [SequentialBranchingPaths.old, List.toFinset_nil, union_empty] using hnext
  have hsub : f ⊆ SequentialBranchingPaths.old p.1 [p.2] := by
    simpa only [SequentialBranchingPaths.old, List.toFinset_cons, List.toFinset_nil,
      insert_empty_eq, SingletonExtensionWeights.join] using hfp
  exact SequentialRetainedWindows.unique_dependent_pair hN p.1 (hE p.1 he).2.1 (hE p.1 he).1
    (hE p.1 he).2.2 1 [p.2] hpath f hsub (hE f hf).2.1 (hE f hf).2.2

theorem finite_overcount {N L : ℕ} (hN : 2 ≤ N) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, e ⊆ dyadicBlock N ∧ e.card = 2 ∧ 0 < runRelativeNullity L e) :
    |mass (dyadicBlock N) E (infiniteJointMoment L) - designated (dyadicBlock N) E (infiniteJointMoment L)| ≤
      exceptional (dyadicBlock N) E (bad N L) (infiniteJointMoment L) :=
  finite_error _ _ _ _ (infiniteJointMoment_nonneg L) (retained_source_unique hN E hE)

theorem weighted_conditional (L : ℕ) (e : Finset ℕ) (z : ℕ) (hq : 0 < infiniteJointMoment L e) :
    infiniteJointMoment L e * conditionalStart e L z = infiniteJointMoment L (insert z e) := by
  unfold conditionalStart
  field_simp

theorem designated_eq (N L : ℕ) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, 0 < infiniteJointMoment L e) :
    designated (dyadicBlock N) E (infiniteJointMoment L) =
      ∑ e ∈ E, infiniteJointMoment L e * freshMean N L e := by
  rw [designated_iterated]
  apply sum_congr rfl
  intro e he
  rw [freshMean, mul_sum]
  exact sum_congr rfl (fun z _ ↦ (weighted_conditional L e z (hE e he)).symm)

theorem exceptional_iterated (N L : ℕ) (E : Finset (Finset ℕ)) :
    exceptional (dyadicBlock N) E (bad N L) (infiniteJointMoment L) =
      ∑ e ∈ E, ∑ z ∈ (dyadicBlock N \ e) ∩ bad N L e, infiniteJointMoment L (insert z e) := by
  have hfilters (e : Finset ℕ) : (dyadicBlock N \ e) ∩ bad N L e =
      (dyadicBlock N).filter (fun z ↦ z ∉ e ∧ z ∈ bad N L e) := by ext z; simp [and_assoc]
  simp_rw [hfilters]
  simp only [exceptional, points, sum_filter, sum_product,
    SingletonExtensionWeights.join, union_singleton]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro z _
  by_cases hfresh : z ∈ e <;> by_cases hbad : z ∈ bad N L e <;> simp [hfresh, hbad]

theorem source_exception_bound (N L : ℕ) (e : Finset ℕ) (hq : 0 < infiniteJointMoment L e) :
    (∑ z ∈ (dyadicBlock N \ e) ∩ bad N L e, infiniteJointMoment L (insert z e)) ≤
      infiniteJointMoment L e * ((bad N L e).card * (2 ^ L : ℝ)⁻¹ + positiveDeviation N L e) := by
  let T := (dyadicBlock N \ e) ∩ bad N L e
  have hpoint : ∀ z ∈ T, infiniteJointMoment L (insert z e) ≤
      infiniteJointMoment L e * ((2 ^ L : ℝ)⁻¹ + max 0 (conditionalStart e L z - (2 ^ L : ℝ)⁻¹)) := by
    intro z _
    rw [← weighted_conditional L e z hq]
    apply mul_le_mul_of_nonneg_left _ hq.le
    have hh := le_max_right 0 (conditionalStart e L z - (2 ^ L : ℝ)⁻¹)
    linarith only [hh]
  have hcount : (T.card : ℝ) ≤ (bad N L e).card := by exact_mod_cast card_le_card inter_subset_right
  have hpos : (∑ z ∈ T, max 0 (conditionalStart e L z - (2 ^ L : ℝ)⁻¹)) ≤ positiveDeviation N L e :=
    sum_le_sum_of_subset_of_nonneg inter_subset_left (fun _ _ _ ↦ le_max_left _ _)
  calc
    _ ≤ ∑ z ∈ T, infiniteJointMoment L e * ((2 ^ L : ℝ)⁻¹ + max 0 (conditionalStart e L z - (2 ^ L : ℝ)⁻¹)) := sum_le_sum hpoint
    _ = infiniteJointMoment L e * ((T.card : ℝ) * (2 ^ L : ℝ)⁻¹ +
        ∑ z ∈ T, max 0 (conditionalStart e L z - (2 ^ L : ℝ)⁻¹)) := by
      rw [← mul_sum, sum_add_distrib, sum_const, nsmul_eq_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (add_le_add (mul_le_mul_of_nonneg_right hcount (by positivity)) hpos) hq.le

theorem exceptional_bound (N L : ℕ) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, 0 < infiniteJointMoment L e) :
    exceptional (dyadicBlock N) E (bad N L) (infiniteJointMoment L) ≤
      ∑ e ∈ E, infiniteJointMoment L e * ((bad N L e).card * (2 ^ L : ℝ)⁻¹ + positiveDeviation N L e) := by
  rw [exceptional_iterated]
  exact sum_le_sum (fun e he ↦ source_exception_bound N L e (hE e he))

theorem ordered_mass_eq (N L : ℕ) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, e ⊆ dyadicBlock N ∧ e.card = 2) :
    orderedMass N L E = 6 * mass (dyadicBlock N) E (infiniteJointMoment L) := by
  have hF : families (dyadicBlock N) E ⊆ (dyadicBlock N).powersetCard 3 := by
    intro I hI
    obtain ⟨hIG, hcard, _⟩ := family_data hE hI
    exact mem_powersetCard.mpr ⟨hIG, hcard⟩
  have hh := OrderedSubsetWeights.weighted_sum (dyadicBlock N) 3 (families (dyadicBlock N) E) hF (infiniteJointMoment L)
  norm_num only [Nat.factorial, Nat.cast_ofNat, Nat.reduceMul, Nat.reduceAdd] at hh
  exact hh

theorem positive_source_restoration (N L : ℕ) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, e ⊆ dyadicBlock N ∧ e.card = 2) :
    mass (dyadicBlock N) (E.filter fun e ↦ 0 < infiniteJointMoment L e) (infiniteJointMoment L) =
      mass (dyadicBlock N) E (infiniteJointMoment L) := by
  let P := E.filter fun e ↦ 0 < infiniteJointMoment L e
  have hP : ∀ e ∈ P, e ⊆ dyadicBlock N ∧ e.card = 2 := fun e he ↦ hE e (mem_filter.mp he).1
  have hsub : families (dyadicBlock N) P ⊆ families (dyadicBlock N) E := by
    intro I hI
    obtain ⟨hIG, hcard, e, he, heI⟩ := family_data hP hI
    rw [families_eq hE]
    exact mem_filter.mpr ⟨mem_powersetCard.mpr ⟨hIG, hcard⟩, e, (mem_filter.mp he).1, heI⟩
  apply sum_subset hsub
  intro I hI hnot
  obtain ⟨hIG, hcard, e, he, heI⟩ := family_data hE hI
  have hqe : infiniteJointMoment L e = 0 := by
    by_cases hp : 0 < infiniteJointMoment L e
    · apply False.elim
      apply hnot
      rw [families_eq hP]
      exact mem_filter.mpr ⟨mem_powersetCard.mpr ⟨hIG, hcard⟩, e, mem_filter.mpr ⟨he, hp⟩, heI⟩
    · exact le_antisymm (not_lt.mp hp) (infiniteJointMoment_nonneg L e)
  exact le_antisymm ((MissingBlockProbabilities.infiniteJointMoment_antitone L heI).trans_eq hqe)
    (infiniteJointMoment_nonneg L I)

theorem ordered_source_restoration (N L : ℕ) (E : Finset (Finset ℕ))
    (hE : ∀ e ∈ E, e ⊆ dyadicBlock N ∧ e.card = 2) :
    orderedMass N L (E.filter fun e ↦ 0 < infiniteJointMoment L e) = orderedMass N L E := by
  rw [ordered_mass_eq N L _ (fun e he ↦ hE e (mem_filter.mp he).1), ordered_mass_eq N L E hE,
    positive_source_restoration N L E hE]

end PaperP1.GoodPairGeneratedTriples
