module

public import PaperP1.Coding.HammingBound
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Residual binary codes

The residual construction used in the proof of the binary Griesmer bound.
Coordinates in the support of a minimum-weight codeword are deleted. The
kernel is precisely the line generated by that word; the residual code has
one less dimension and at least half the old minimum distance, rounded up.

The coordinate type is arbitrary and finite, so the construction can be
iterated on the actual complement of a support without choosing an ordering.
-/

@[expose] public section

namespace PaperP1.BinaryResidual

open PaperP1.Arithmetic Finset

local instance residualPrimeTwo : Fact (Nat.Prime 2) := Fact.mk Nat.prime_two

abbrev Word (ι : Type*) := ι → F₂

variable {ι : Type*} [Fintype ι]

/-- The set of nonzero coordinates of a binary word. -/
def support (x : Word ι) : Finset ι :=
  Finset.univ.filter fun i ↦ x i ≠ 0

@[simp]
theorem card_support (x : Word ι) : (support x).card = hammingNorm x := rfl

/-- A non-strict minimum-weight lower bound, including the zero code. -/
def MinWeightAtLeast (C : Submodule F₂ (Word ι)) (d : ℕ) : Prop :=
  ∀ x : C, x ≠ 0 → d ≤ hammingNorm (x : Word ι)

/-- A word attaining the least positive weight of a code. -/
def IsMinimumWord (C : Submodule F₂ (Word ι)) (c : C) : Prop :=
  c ≠ 0 ∧ ∀ x : C, x ≠ 0 → hammingNorm (c : Word ι) ≤ hammingNorm (x : Word ι)

theorem eq_of_support_eq {x y : Word ι} (h : support x = support y) : x = y := by
  funext i
  have hi : x i ≠ 0 ↔ y i ≠ 0 := by
    have := Finset.ext_iff.mp h i
    simpa only [support, Finset.mem_filter, Finset.mem_univ, true_and] using this
  by_cases hx : x i = 0
  · have hy : y i = 0 := by simpa only [hx, ne_eq, not_true_eq_false, false_iff,
      not_not] using hi
    simp only [hx, hy]
  · rw [HammingBound.eq_one_of_ne_zero _ hx,
      HammingBound.eq_one_of_ne_zero _ (hi.mp hx)]

/-- Delete the coordinates at which `c` is nonzero. -/
def puncture (C : Submodule F₂ (Word ι)) (c : C) :
    C →ₗ[F₂] Word {i : ι // (c : Word ι) i = 0} where
  toFun x i := (x : Word ι) i
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The actual image of the coordinate deletion map. -/
def residualCode (C : Submodule F₂ (Word ι)) (c : C) :
    Submodule F₂ (Word {i : ι // (c : Word ι) i = 0}) :=
  LinearMap.range (puncture C c)

theorem mem_ker_puncture_iff (C : Submodule F₂ (Word ι)) (c x : C) :
    x ∈ LinearMap.ker (puncture C c) ↔ support (x : Word ι) ⊆ support (c : Word ι) := by
  classical
  constructor
  · intro hx i hi
    simp only [support, Finset.mem_filter, Finset.mem_univ, true_and] at hi ⊢
    intro hc
    have hz := congrFun (LinearMap.mem_ker.mp hx) ⟨i, hc⟩
    exact hi hz
  · intro hx
    apply LinearMap.mem_ker.mpr
    funext i
    change (x : Word ι) i = 0
    by_contra hi
    have hxi : (i : ι) ∈ support (x : Word ι) := by
      simpa only [support, Finset.mem_filter, Finset.mem_univ, true_and] using hi
    have hc := hx hxi
    exact (Finset.mem_filter.mp hc).2 i.property

/-- Deleting a minimum word kills exactly its one-dimensional span. -/
theorem ker_puncture_eq_span (C : Submodule F₂ (Word ι)) (c : C)
    (hc : IsMinimumWord C c) :
    LinearMap.ker (puncture C c) = Submodule.span F₂ {c} := by
  classical
  apply le_antisymm
  · intro x hx
    by_cases hx0 : x = 0
    · simpa only [hx0] using (Submodule.zero_mem (Submodule.span F₂ {c}))
    have hsubset := (mem_ker_puncture_iff C c x).mp hx
    have heq : support (x : Word ι) = support (c : Word ι) :=
      Finset.eq_of_subset_of_card_le hsubset (hc.2 x hx0)
    have hxc : x = c := Subtype.ext (eq_of_support_eq heq)
    simpa only [hxc] using (Submodule.mem_span_singleton_self c :
      c ∈ Submodule.span F₂ {c})
  · apply Submodule.span_le.mpr
    intro x hx
    have hxc : x = c := Set.mem_singleton_iff.mp hx
    subst x
    exact (mem_ker_puncture_iff C c c).mpr (Finset.Subset.refl _)

/-- Rank--nullity for the residual construction. -/
theorem finrank_residual_add_one (C : Submodule F₂ (Word ι)) (c : C)
    (hc : IsMinimumWord C c) :
    Module.finrank F₂ (residualCode C c) + 1 = Module.finrank F₂ C := by
  have h := (puncture C c).finrank_range_add_finrank_ker
  rw [ker_puncture_eq_span C c hc, finrank_span_singleton hc.1] at h
  exact h

/-- The number of retained coordinates plus the deleted weight is the old length. -/
theorem card_outside_add_weight (c : Word ι) :
    Fintype.card {i : ι // c i = 0} + hammingNorm c = Fintype.card ι := by
  classical
  rw [Fintype.card_subtype, hammingNorm]
  simpa only [ne_eq, Finset.card_univ] using
    (Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset ι))
      (p := fun i ↦ c i = 0))

/-- A positive-dimensional finite code contains a minimum nonzero word. -/
theorem exists_minimum_word (C : Submodule F₂ (Word ι))
    (hr : 0 < Module.finrank F₂ C) : ∃ c : C, IsMinimumWord C c := by
  classical
  obtain ⟨x, hx⟩ := Module.finrank_pos_iff_exists_ne_zero.mp hr
  have hex : ∃ w : ℕ, ∃ c : C, c ≠ 0 ∧ hammingNorm (c : Word ι) = w :=
    ⟨_, x, hx, rfl⟩
  obtain ⟨c, hc, hcw⟩ := Nat.find_spec hex
  refine ⟨c, hc, fun y hy ↦ ?_⟩
  rw [hcw]
  exact Nat.find_min' hex ⟨y, hy, rfl⟩

theorem weight_eq_sum (x : Word ι) :
    hammingNorm x = ∑ i : ι, if x i = 0 then 0 else 1 := by
  classical
  simp only [hammingNorm, Finset.card_eq_sum_ones, Finset.sum_filter, ite_not]

theorem weight_puncture (C : Submodule F₂ (Word ι)) (c x : C) :
    hammingNorm (puncture C c x) =
      ∑ i : ι, if (c : Word ι) i = 0 then
        (if (x : Word ι) i = 0 then 0 else 1) else 0 := by
  classical
  rw [weight_eq_sum, ← Finset.sum_filter]
  exact (Finset.sum_subtype (Finset.univ.filter fun i ↦ (c : Word ι) i = 0)
    (fun i ↦ by simp only [Finset.mem_filter, Finset.mem_univ, true_and])
    (fun i ↦ if (x : Word ι) i = 0 then 0 else 1)).symm

/-- On the deleted support the two lifts are complementary; on retained
coordinates they agree. -/
theorem weight_add_complement (C : Submodule F₂ (Word ι)) (c x : C) :
    hammingNorm (x : Word ι) + hammingNorm ((x + c : C) : Word ι) =
      2 * hammingNorm (puncture C c x) + hammingNorm (c : Word ι) := by
  classical
  rw [weight_eq_sum, weight_eq_sum, weight_puncture, weight_eq_sum,
    Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  change (if (x : Word ι) i = 0 then 0 else 1) +
    (if (x : Word ι) i + (c : Word ι) i = 0 then 0 else 1) = _
  by_cases hc : (c : Word ι) i = 0
  · by_cases hx : (x : Word ι) i = 0 <;> simp [hc, hx]
  · have hc1 := HammingBound.eq_one_of_ne_zero _ hc
    by_cases hx : (x : Word ι) i = 0
    · simp [hc1, hx]
    · have hx1 := HammingBound.eq_one_of_ne_zero _ hx
      have h11 : (1 : F₂) + 1 = 0 := by decide
      simp only [hc1, hx1, h11]
      norm_num

/-- The residual minimum distance is at least the old minimum distance
divided by two and rounded up. -/
theorem residual_minWeight (C : Submodule F₂ (Word ι)) (c : C)
    (hc : IsMinimumWord C c) :
    MinWeightAtLeast (residualCode C c) ((hammingNorm (c : Word ι) + 1) / 2) := by
  intro y hy
  obtain ⟨x, hx⟩ := y.property
  have hx0 : x ≠ 0 := by
    intro h
    apply hy
    apply Subtype.ext
    simp only [← hx, h, map_zero, Submodule.coe_zero]
  have hxc0 : x + c ≠ 0 := by
    intro h
    apply hy
    apply Subtype.ext
    have hm := congrArg (puncture C c) h
    have hpc : puncture C c c = 0 := by
      funext i
      exact i.property
    rw [map_add, map_zero, hpc, add_zero] at hm
    exact hx ▸ hm
  have hminx := hc.2 x hx0
  have hminxc := hc.2 (x + c) hxc0
  have hid := weight_add_complement C c x
  have hw : hammingNorm (puncture C c x) = hammingNorm (y : Word _) :=
    congrArg hammingNorm hx
  rw [hw] at hid
  omega

end PaperP1.BinaryResidual
